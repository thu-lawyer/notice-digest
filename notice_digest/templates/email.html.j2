<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$subject</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;">
<div class="nd-wrap" style="max-width:680px;margin:0 auto;padding:20px 16px;background:#ffffff;font-family:-apple-system,'PingFang SC','Microsoft YaHei',Helvetica,Arial,sans-serif;color:#20211e;font-size:15px;line-height:1.7;word-break:break-word;overflow-wrap:anywhere;">
  <h1 class="nd-title" style="font-size:19px;line-height:1.5;margin:0 0 6px;word-break:break-word;overflow-wrap:anywhere;">$subject</h1>
  <p class="nd-meta-line" style="margin:0 0 14px;color:#6b6f6a;font-size:13px;word-break:break-word;overflow-wrap:anywhere;">$meta_line</p>
$banner
$sections
  <p class="nd-footer" style="margin:18px 0 0;padding-top:10px;border-top:1px solid #e3e5e1;color:#8a8f89;font-size:12px;word-break:break-word;overflow-wrap:anywhere;">$footer</p>
</div>
</body>
</html>
