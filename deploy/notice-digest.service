[Unit]
Description=notice-digest 每日通知摘要（抓取→加工→排序→投递）
Documentation=file:/opt/notice-digest/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# 失败即发信：模板单元实例名 = 失败单元的 %n，即 "notice-digest.service"
OnFailure=notice-digest-failure@%n.service

[Service]
Type=oneshot
# 独立系统用户，不与其他 /opt 租户共用
User=notice-digest
Group=notice-digest
WorkingDirectory=/opt/notice-digest
# SMTP 口令等只落在这里，权限 0600，永不进 git
EnvironmentFile=/opt/notice-digest/.env

# 用项目 venv 的解释器，不用系统 python3（系统 python 无 requests 等依赖）
# 注意：Type=oneshot 下 systemd 默认禁用启动超时（官方文档：oneshot 的 TimeoutStartSec 默认 disabled），
# 因此 enrich 的 1 req/s 详情限速（最坏 60s+）不会被 systemd 掐断。
# 详情配额（t27 实测，见 docs/RUNBOOK.md §17）：429 墙由**短窗口突发**触发，维持 ≥1s/请求节流即安全；
# --limit 60 是保守上界（配合 t27 的「首次 429 立即收批」降级，超限只影响补全条数、不致命）。
ExecStart=/opt/notice-digest/.venv/bin/python -m notice_digest.cli fetch --pages 30
ExecStart=/opt/notice-digest/.venv/bin/python -m notice_digest.cli enrich --limit 60
ExecStart=/opt/notice-digest/.venv/bin/python -m notice_digest.cli send

# 不需要 systemd 重启：由 timer 每日触发；单次失败由 OnFailure= 发失败邮件
Restart=no

# 退出码语义（见 docs/RUNBOOK.md）：
#   0 = 成功（含仅自愈型偏差、以及「窗口内无新条目」的空投递）
#   3 = 致命（网络 5xx 重试后仍失败 / 非 JSON / 结构漂移 / 首页为空）→ 发失败邮件
#   4 = 投递失败（SMTP 报错）
# 任何非零都会让本单元进入 failed，进而触发 OnFailure=。

[Install]
WantedBy=multi-user.target
