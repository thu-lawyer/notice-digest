[Unit]
Description=notice-digest 反馈接收服务（只监听 127.0.0.1:8791，公网入口由 nginx /nd/ 反代）
Documentation=file:/opt/notice-digest/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notice-digest
Group=notice-digest
WorkingDirectory=/opt/notice-digest
EnvironmentFile=/opt/notice-digest/.env

# 硬约束：只绑回环，绝不对外暴露。应用自身拒绝在缺少 ND_HMAC_SECRET 时启动。
ExecStart=/opt/notice-digest/.venv/bin/python -m notice_digest.cli feedback-serve --host 127.0.0.1 --port 8791

Restart=on-failure
RestartSec=5
# 常驻服务，给它一个启动超时上限
TimeoutStartSec=30
# 少量加固（不依赖 /opt 之外的写权限）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/notice-digest/data

[Install]
WantedBy=multi-user.target
