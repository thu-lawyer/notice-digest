# ============================================================================
# notice-digest 环境变量样例
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env && chmod 0600 .env   # 然后手工填入真实值
#
# 硬规则：
#   * .env 永不进 git（见 .gitignore）；仓库里只保留本样例文件。
#   * 本文件只列**键名与含义**，不放任何真实账号、授权码、密钥。
#   * 键名以 notice_digest/config.py 实际读取的为准（ND_* 前缀）；
#     config.py **不识别 SMTP_* 别名**，写别名会被静默忽略。
#   * 优先级：环境变量 > .env > profile.yaml > 内置默认值。
#   * 生产环境必须显式配置 ND_FEEDBACK_BASE 与 ND_HMAC_SECRET，
#     否则邮件里的 👍/👎 反馈按钮不会渲染（安全降级，不报错）。
# ============================================================================

# ---------------------------------------------------------------- 邮件投递
# 收件地址（日报发到这里）
ND_TO_ADDR=

# 发件地址（同时用作 SMTP 登录账号；须与 SMTP USER 一致或为其授权别名）
ND_FROM_ADDR=

# SMTP 服务器主机名
# 注意：不要使用 smtp.tsinghua.org.cn —— 该域名是 CNAME 别名，证书与主机名不匹配，
# 直连会因证书校验失败而无法投递。
ND_SMTP_HOST=

# SMTP 端口（465 = SSL 直连）
ND_SMTP_PORT=465

# SMTP 登录账号
ND_SMTP_USER=

# SMTP 授权码 / 密码（**这是唯一必须手工填入的敏感项**）
ND_SMTP_PASS=

# ---------------------------------------------------------------- 反馈回路
# 反馈入口的公网基址，用于生成邮件内的 👍/👎 与点击跳转链接。
# 必须是收件人浏览器可达的地址（例如 https://<你的域名>），不能是 127.0.0.1，
# 否则反馈按钮会被省略。nginx 侧把 /nd/ 反代到 127.0.0.1:8791。
ND_FEEDBACK_BASE=

# 反馈链接的 HMAC 签名密钥。未配置时反馈服务拒绝启动。
# 生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ND_HMAC_SECRET=

# ---------------------------------------------------------------- 可选项
# 抓取校区（thu = 清华，ruc = 人大），默认 thu
#ND_CAMPUS=thu

# 数据库路径，默认 <项目根>/data/notice.db
#ND_DB_PATH=/opt/notice-digest/data/notice.db

# 邮件里展示的条目数，默认 20
#ND_TOP_N=20

# HTTP 超时（秒）与重试次数
#ND_TIMEOUT=20
#ND_RETRIES=3

# 失败通知（OnFailure= 触发的 notify-failure）使用的收件地址；
# 留空则复用 ND_TO_ADDR
#ND_FAILURE_TO=
